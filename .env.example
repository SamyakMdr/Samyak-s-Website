# Copy to .env.local and fill in. None of these are needed for local development.

# Public origin of the deployed site, without a trailing slash. Used for canonical
# URLs, Open Graph tags, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Contact form (Resend). Without these the form logs the message in development
# and shows its error state in production.
RESEND_API_KEY=
# Where messages are delivered.
CONTACT_TO_EMAIL=
# Sender address on a domain verified with Resend, e.g. "Portfolio <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=

# Set to 1 to expose the internal UI kit at /dev/ui in a production build.
NEXT_PUBLIC_SHOW_DEV_UI=
